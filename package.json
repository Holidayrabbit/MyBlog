{
  "name": "myblog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "极简个人博客系统 - 基于React+TypeScript",
  "keywords": [
    "react",
    "typescript",
    "blog",
    "vite",
    "github-pages"
  ],
  "author": "ZhaoQie",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run site:generate && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "deploy": "npm run build && gh-pages -d dist",
    "articles:generate": "node scripts/generate-articles.js",
    "rss:generate": "node scripts/generate-rss.js",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "search:generate": "node scripts/generate-search-index.js",
    "site:generate": "npm run articles:generate && npm run rss:generate && npm run sitemap:generate && npm run search:generate"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "i18next": "^25.5.2",
    "js-yaml": "^5.4.2",
    "katex": "^0.16.25",
    "lucide-react": "^0.544.0",
    "minisearch": "^7.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^16.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.3",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vditor": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "puppeteer-core": "^24.43.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  }
}
